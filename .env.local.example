# Copy to .env.local and fill in from your Supabase project (Settings > API).
# Only the public URL and anon key belong here. Never put the service_role key
# in any NEXT_PUBLIC_ variable or in client code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Public demo deployment only (leave these out of your real deployment) ----
# Point the URL and anon key above at the separate DEMO Supabase project, then:
# NEXT_PUBLIC_DEMO_MODE=true
# DEMO_OWNER_PASSWORD=       (server only, never a NEXT_PUBLIC_ variable)
# DEMO_FARMHAND_PASSWORD=
